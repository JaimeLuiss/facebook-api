{
  "info": {
    "_postman_id": "7bcfb9b3-c697-4fa6-85b0-a1737178bc55",
    "name": "Facebook API - Taller Backend",
    "description": "Colección para probar autenticación Sanctum, paginación, likes por usuario, búsqueda, comentarios con notificación por correo y versionado. Orden recomendado: registrar o iniciar sesión, crear una publicación y luego ejecutar las pruebas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registrar usuario principal",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"user_email\", \"carlos+\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");",
                  "pm.collectionVariables.set(\"user_password\", \"password123\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registro responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La respuesta incluye un token\", function () { pm.expect(pm.response.json().token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Gomez\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/register",
            "description": "Registra una cuenta de prueba. El token de la respuesta se guarda automáticamente en la variable de colección token."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta incluye un token\", function () { pm.expect(pm.response.json().token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/login",
            "description": "Usa una cuenta que ya exista. El token se guarda automáticamente en token."
          },
          "response": []
        },
        {
          "name": "Registrar segundo usuario (para probar likes)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Segundo registro responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La respuesta incluye un token\", function () { pm.expect(pm.response.json().token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"token2\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Gomez\",\n  \"email\": \"ana{{$guid}}@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/register",
            "description": "Crea una segunda identidad de prueba y guarda su token en token2 sin reemplazar token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Publicaciones, paginación y búsqueda",
      "item": [
        {
          "name": "Crear publicación (y guardar ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La publicación se crea\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La respuesta incluye el ID\", function () { pm.expect(pm.response.json().id).to.exist; });",
                  "pm.collectionVariables.set(\"postId\", String(pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Viaje de prueba {{$timestamp}}",
                  "type": "text"
                },
                {
                  "key": "content",
                  "value": "Publicación para comprobar la API desde Postman",
                  "type": "text"
                },
                {
                  "key": "images[]",
                  "type": "file",
                  "disabled": true,
                  "description": "Opcional: habilita este campo y selecciona un archivo de imagen local."
                }
              ]
            },
            "url": "{{base_url}}/posts",
            "description": "Requiere token. Envía title y content como form-data. Para probar imágenes, habilita images[] y escoge un archivo desde tu equipo. Postman guarda el ID devuelto en postId."
          },
          "response": []
        },
        {
          "name": "Listar publicaciones (página 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Lista responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta está paginada\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    pm.expect(body).to.have.property(\"current_page\");",
                  "    pm.expect(body).to.have.property(\"last_page\");",
                  "    pm.expect(body).to.have.property(\"per_page\", 10);",
                  "    pm.expect(body).to.have.property(\"total\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts?page=1",
            "description": "Prueba la respuesta paginada; repite cambiando page=1 por page=2."
          },
          "response": []
        },
        {
          "name": "Listar publicaciones (página 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Página 2 responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta indica la página solicitada\", function () { pm.expect(pm.response.json().current_page).to.eql(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts?page=2",
            "description": "Si no hay suficientes publicaciones, la página 2 puede tener data vacía; crea más de diez publicaciones para comprobarla."
          },
          "response": []
        },
        {
          "name": "Buscar publicaciones por palabra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Búsqueda responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta conserva metadatos de paginación\", function () { pm.expect(pm.response.json()).to.have.property(\"total\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts?search=viaje",
            "description": "Cambia viaje por una palabra que aparezca en title o content de tus publicaciones."
          },
          "response": []
        },
        {
          "name": "Consultar publicación por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Detalle responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El ID coincide con postId\", function () { pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"postId\")); });",
                  "pm.test(\"La respuesta incluye likes_count\", function () { pm.expect(pm.response.json()).to.have.property(\"likes_count\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/{{postId}}",
            "description": "Consulta la publicación creada y guardada automáticamente en postId."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Likes por usuario",
      "item": [
        {
          "name": "Dar like con usuario principal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Like responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El conteo de likes es numérico\", function () { pm.expect(pm.response.json().likes_count).to.be.a(\"number\"); });",
                  "pm.collectionVariables.set(\"primaryLikesCount\", String(pm.response.json().likes_count));",
                  "pm.collectionVariables.set(\"primaryLikedPostId\", pm.collectionVariables.get(\"postId\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/{{postId}}/like",
            "description": "Requiere token principal. Envía la solicitud dos veces y confirma que likes_count no suba en el segundo envío."
          },
          "response": []
        },
        {
          "name": "Dar like con el mismo usuario otra vez (no debe duplicar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Like repetido responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El like repetido no aumenta el conteo\", function () {",
                  "    pm.expect(pm.collectionVariables.get(\"primaryLikedPostId\")).to.eql(pm.collectionVariables.get(\"postId\"));",
                  "    pm.expect(String(pm.response.json().likes_count)).to.eql(pm.collectionVariables.get(\"primaryLikesCount\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/{{postId}}/like",
            "description": "Envía esta solicitud después de Dar like con usuario principal; verifica que el mismo usuario no cuente dos veces."
          },
          "response": []
        },
        {
          "name": "Dar like con segundo usuario (debe aumentar en uno)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Like del segundo usuario responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"El like de otro usuario incrementa el conteo en uno\", function () {",
                  "    const previous = Number(pm.collectionVariables.get(\"primaryLikesCount\"));",
                  "    pm.expect(pm.collectionVariables.get(\"primaryLikedPostId\")).to.eql(pm.collectionVariables.get(\"postId\"));",
                  "    pm.expect(pm.response.json().likes_count).to.eql(previous + 1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token2}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{base_url}}/posts/{{postId}}/like",
            "description": "Primero ejecuta Registrar segundo usuario. Esta solicitud usa token2 y comprueba que otro usuario sí aumenta el conteo en uno."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Comentarios y correo",
      "item": [
        {
          "name": "Agregar comentario (notifica al dueño)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Comentario creado\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"El autor se toma del usuario autenticado\", function () { pm.expect(pm.response.json().author).to.be.a(\"string\"); });",
                  "pm.test(\"El contenido coincide\", function () { pm.expect(pm.response.json().content).to.eql(\"Buen post desde Postman\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Buen post desde Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/posts/{{postId}}/comments",
            "description": "Requiere token. El nombre del autor se toma de la cuenta autenticada, no envíes author. Con MAIL_MAILER=log, revisa storage/logs/laravel.log para comprobar el correo al dueño."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Autorización y versionado",
      "item": [
        {
          "name": "Crear publicación sin token (debe responder 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La API rechaza la solicitud anónima\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prueba anónima\",\n  \"content\": \"No debe crearse\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/posts",
            "description": "Esta solicitud desactiva explícitamente la autorización heredada para demostrar que POST /posts está protegido."
          },
          "response": []
        },
        {
          "name": "Agregar comentario sin token (debe responder 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La API rechaza el comentario anónimo\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"No debe guardarse\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/posts/{{postId}}/comments",
            "description": "Comprueba que comentar requiere autenticación."
          },
          "response": []
        },
        {
          "name": "Listar usando ruta antigua (compatibilidad)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La ruta antigua sigue respondiendo 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta antigua también está paginada\", function () { pm.expect(pm.response.json()).to.have.property(\"data\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{app_url}}/api/posts",
            "description": "Comprueba que las rutas anteriores a /api/v1 siguen funcionando."
          },
          "response": []
        },
        {
          "name": "Consultar documentación Scribe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La documentación está disponible\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{app_url}}/docs",
            "description": "Abre la documentación de endpoints de la API."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Limpieza (opcional)",
      "item": [
        {
          "name": "Eliminar publicación de prueba",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La publicación se eliminó (204)\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/{{postId}}",
            "description": "Requiere token y elimina la publicación creada para la prueba."
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Cerrar sesión (al final)",
      "item": [
        {
          "name": "Cerrar sesión y revocar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logout responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.unset(\"token\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/logout",
            "description": "Ejecuta al final, después de todas las demás pruebas: revoca el token principal y lo elimina de las variables de colección."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "app_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "token2",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "primaryLikesCount",
      "value": "",
      "type": "string"
    },
    {
      "key": "primaryLikedPostId",
      "value": "",
      "type": "string"
    }
  ]
}
